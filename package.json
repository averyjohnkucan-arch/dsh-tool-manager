{
  "name": "dsh-tool-manager",
  "version": "0.5.2-rc4.1",
  "type": "module",
  "license": "MIT",
  "description": "Find installed tools and skills on demand, and choose which tool definitions stay in the model context.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "LICENSE",
    "COMPATIBILITY.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check client.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.4",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.4",
    "zod": "4.6.6",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.4",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.4",
    "zod": "4.6.6",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.4",
    "@deepseek-ai/dsh-session": "0.2.2-rc.4",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.4",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.4",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.4",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.4",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "dsh": "0.2.2-rc.4"
  }
}
